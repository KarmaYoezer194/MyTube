rules_version = '2';

// MyTube security rules (Phase 12: final rules; Phase 13: channels;
// Phase 14: replies, comment counters, edit, pin and creator heart;
// Phase 15: playlists; Phase 17: notifications; Phase 18: search
// keywords; Phase 19: reports; Phase 20: security review fixes).
//
// There is no server (free Spark plan, no Cloud Functions), so the app does
// the "server" work itself and THESE RULES are what keeps it honest:
// every write is checked field by field, and counters (likes, views) can
// only move by one, together with the matching record of who did it.
//
// Two kinds of users are always "signed in" to Firebase:
// - GUESTS: anonymous users, created automatically. They can watch:
//   read, keep their own watch history, add +1 view, fill in a video length.
// - ACCOUNTS: signed in with email/password or Google. They can also like,
//   comment, subscribe, save to Watch later, upload and have a profile.
//
// request.auth.token.firebase.sign_in_provider is 'anonymous' for guests
// and 'password' or 'google.com' for accounts.
//
// Anything not allowed below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= Helpers =================

    // Anyone using the app (guest or account).
    function signedIn() {
      return request.auth != null;
    }

    // A real account, not a guest.
    function hasAccount() {
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // This is me (guest or account).
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // This is me AND I have a real account.
    function isMyAccount(uid) {
      return hasAccount() && request.auth.uid == uid;
    }

    // The fields this update changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The update changes ONLY these fields.
    function onlyChanges(fields) {
      return changedKeys().hasOnly(fields);
    }

    // This update changes [field].
    function changes(field) {
      return field in changedKeys();
    }

    // A text of [min]..[max] characters.
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // A link to a file in OUR Cloudinary account (cloud 'hcrar4ku').
    // Uploads may only point there, not to any other website.
    function isCloudinaryUrl(value) {
      return value is string && value.size() <= 500 &&
        value.matches('https://res[.]cloudinary[.]com/hcrar4ku/(video|image)/upload/.+');
    }

    // Path helpers.
    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function videoDoc(videoId) {
      return /databases/$(database)/documents/videos/$(videoId);
    }
    function commentDoc(videoId, commentId) {
      return /databases/$(database)/documents/videos/$(videoId)/comments/$(commentId);
    }
    function replyDoc(videoId, commentId, replyId) {
      return /databases/$(database)/documents/videos/$(videoId)/comments/$(commentId)/replies/$(replyId);
    }
    function myReactionDoc(videoId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/reactions/$(videoId);
    }
    function channelDoc(channelId) {
      return /databases/$(database)/documents/channels/$(channelId);
    }
    function handleDoc(handle) {
      return /databases/$(database)/documents/handles/$(handle);
    }
    function mySubscriptionDoc(channelId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/subscribed/$(channelId);
    }

    // "@karmayoezer4821": lower-case letters, digits, '.', '_' or '-'.
    function isHandle(value) {
      return value is string && value.matches('@[a-z0-9._-]{3,30}');
    }

    // After this request, [handle] is reserved for me in handles/.
    function handleIsMineAfter(handle) {
      return existsAfter(handleDoc(handle)) &&
        getAfter(handleDoc(handle)).data.uid == request.auth.uid;
    }

    // Search keywords (word beginnings, see search_keywords.dart).
    function isKeywords(value) {
      return value is list && value.size() <= 200;
    }

    // Documents from before Phase 18 have no keywords: anyone who sees
    // one may add them, once (only while the field is missing).
    function isKeywordsFillIn() {
      return signedIn() && onlyChanges(['keywords']) &&
        !('keywords' in resource.data) &&
        isKeywords(request.resource.data.keywords);
    }

    // A color saved as a number, like 0xFFD81B60.
    function isColor(value) {
      return value is int && value >= 0 && value <= 4294967295;
    }

    function myCommentLikeDoc(videoId, commentId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/commentLikes/$(videoId + '_' + commentId);
    }

    // ---- Comment counters ----
    // videos/{id}.commentCount = comments + replies;
    // comments/{id}.replyCount = replies of that comment.
    // Older documents have no counter yet: it counts as 0.

    // [actual] is [expected] - or 0, when [expected] would be below 0
    // (a counter never goes negative).
    function countIs(expected, actual) {
      return actual == expected || (expected < 0 && actual == 0);
    }
    // The video's comment counter moved by [change] in this batch.
    function commentCountMovedBy(videoId, change) {
      return countIs(
        get(videoDoc(videoId)).data.get('commentCount', 0) + change,
        getAfter(videoDoc(videoId)).data.get('commentCount', 0));
    }
    // A comment's reply counter moved by [change] in this batch.
    function replyCountMovedBy(videoId, commentId, change) {
      return countIs(
        get(commentDoc(videoId, commentId)).data.get('replyCount', 0) + change,
        getAfter(commentDoc(videoId, commentId)).data.get('replyCount', 0));
    }

    // A new comment or reply: posted as ME, with my real profile name and
    // @handle, 0 likes, server time. [keys] are the allowed fields.
    function isNewCommentByMe(keys) {
      let d = request.resource.data;
      let me = get(userDoc(request.auth.uid)).data;
      return hasAccount() &&
        d.keys().hasOnly(keys) &&
        d.uid == request.auth.uid &&
        d.displayName == me.displayName &&
        d.handle == me.handle &&
        (d.avatarUrl == '' || isCloudinaryUrl(d.avatarUrl)) &&
        isText(d.text, 1, 1000) &&
        d.likes == 0 &&
        d.createdAt == request.time;
    }
    // The author changes the text (the app then shows "(edited)").
    function isAuthorEdit() {
      return isMyAccount(resource.data.uid) &&
        onlyChanges(['text', 'edited', 'editedAt']) &&
        isText(request.resource.data.text, 1, 1000) &&
        request.resource.data.edited == true &&
        request.resource.data.editedAt == request.time;
    }
    // The video's uploader gives (or takes back) a heart.
    function isCreatorHeart(videoId) {
      return hasAccount() &&
        get(videoDoc(videoId)).data.uploaderUid == request.auth.uid &&
        onlyChanges(['hearted']) &&
        request.resource.data.hearted is bool;
    }
    // Any account likes / unlikes a comment or reply ([id]): +1 / -1,
    // together with my own commentLikes record.
    function isCommentLikeChange(videoId, id) {
      return hasAccount() && onlyChanges(['likes']) &&
        ((request.resource.data.likes == resource.data.likes + 1 &&
            !exists(myCommentLikeDoc(videoId, id)) &&
            existsAfter(myCommentLikeDoc(videoId, id))) ||
          (request.resource.data.likes == resource.data.likes - 1 &&
            exists(myCommentLikeDoc(videoId, id)) &&
            !existsAfter(myCommentLikeDoc(videoId, id))));
    }

    // ---- Video likes <-> my reaction ----
    // The like counter on a video and my reactions/{videoId} record are
    // written together in one batch. Before / after that batch:
    function likedBefore(videoId) {
      return exists(myReactionDoc(videoId)) &&
        get(myReactionDoc(videoId)).data.value == 1;
    }
    function likedAfter(videoId) {
      return existsAfter(myReactionDoc(videoId)) &&
        getAfter(myReactionDoc(videoId)).data.value == 1;
    }

    // ================= Users =================
    match /users/{uid} {

      // A valid profile name.
      function isName(value) {
        return isText(value, 1, 50);
      }
      // Empty (letter avatar) or a Cloudinary picture.
      function isAvatarUrl(value) {
        return value == '' || isCloudinaryUrl(value);
      }
      // Profiles (name, @handle, avatar) are public; only accounts have one.
      allow read: if signedIn();

      allow create: if isMyAccount(uid) &&
        request.resource.data.keys().hasOnly(
          ['displayName', 'handle', 'avatarUrl', 'avatarColor', 'createdAt']) &&
        request.resource.data.keys().hasAll(
          ['displayName', 'handle', 'avatarUrl', 'avatarColor', 'createdAt']) &&
        isName(request.resource.data.displayName) &&
        isHandle(request.resource.data.handle) &&
        isAvatarUrl(request.resource.data.avatarUrl) &&
        isColor(request.resource.data.avatarColor) &&
        request.resource.data.createdAt == request.time;

      // Older profiles may have an old-style handle; it only has to be
      // valid when it is CHANGED, and a new handle must be reserved for me
      // in handles/ in the same batch.
      allow update: if isMyAccount(uid) &&
        onlyChanges(['displayName', 'handle', 'avatarUrl', 'avatarColor']) &&
        (!changes('displayName') || isName(request.resource.data.displayName)) &&
        (!changes('handle') || (isHandle(request.resource.data.handle) &&
          handleIsMineAfter(request.resource.data.handle))) &&
        (!changes('avatarUrl') || isAvatarUrl(request.resource.data.avatarUrl)) &&
        (!changes('avatarColor') || isColor(request.resource.data.avatarColor));

      // Profiles are never deleted from the app.
      allow delete: if false;

      // ---- Watch history (guests have one too) ----
      // history/{videoId}: watchedAt (server time), positionSeconds.
      match /history/{videoId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) &&
          request.resource.data.keys().hasOnly(['watchedAt', 'positionSeconds']) &&
          request.resource.data.watchedAt == request.time &&
          request.resource.data.positionSeconds is int &&
          request.resource.data.positionSeconds >= 0 &&
          request.resource.data.positionSeconds <= 86400;
      }

      // ---- Likes / dislikes ----
      // reactions/{videoId}: value (1 = like, -1 = dislike), reactedAt.
      // The video's like counter must change in the same batch:
      // +1 when it becomes a like, -1 when a like goes away.
      match /reactions/{videoId} {
        function videoLikesFollow() {
          return !exists(videoDoc(videoId)) ||
            (likedBefore(videoId) == likedAfter(videoId) &&
              getAfter(videoDoc(videoId)).data.likes ==
                get(videoDoc(videoId)).data.likes) ||
            (!likedBefore(videoId) && likedAfter(videoId) &&
              getAfter(videoDoc(videoId)).data.likes ==
                get(videoDoc(videoId)).data.likes + 1) ||
            (likedBefore(videoId) && !likedAfter(videoId) &&
              getAfter(videoDoc(videoId)).data.likes ==
                get(videoDoc(videoId)).data.likes - 1);
        }

        allow read: if isMe(uid);
        allow create, update: if isMyAccount(uid) &&
          request.resource.data.keys().hasOnly(['value', 'reactedAt']) &&
          request.resource.data.value in [1, -1] &&
          request.resource.data.reactedAt == request.time &&
          videoLikesFollow();
        allow delete: if isMyAccount(uid) && videoLikesFollow();
      }

      // ---- Watch later ----
      // watchLater/{videoId}: addedAt.
      match /watchLater/{videoId} {
        allow read: if isMe(uid);
        allow create, update: if isMyAccount(uid) &&
          request.resource.data.keys().hasOnly(['addedAt']) &&
          request.resource.data.addedAt == request.time;
        allow delete: if isMyAccount(uid);
      }

      // ---- Subscriptions ----
      // subscribed/{channelId}: addedAt, channelId (same as the document
      // name; lets the channel find its subscribers - see the
      // collection-group rule at the end).
      // The channel's subscriberCount must go +1 / -1 in the same batch
      // (channels without a document - old uploads - have no counter).
      // You can't subscribe to your own channel.
      match /subscribed/{channelId} {
        function subscribersChangeBy(change) {
          return getAfter(channelDoc(channelId)).data.subscriberCount ==
            get(channelDoc(channelId)).data.subscriberCount + change;
        }

        allow read: if isMe(uid);
        allow create: if isMyAccount(uid) &&
          channelId != 'user-' + uid &&
          request.resource.data.keys().hasOnly(['addedAt', 'channelId']) &&
          (!('channelId' in request.resource.data) ||
            request.resource.data.channelId == channelId) &&
          request.resource.data.addedAt == request.time &&
          (!exists(channelDoc(channelId)) || subscribersChangeBy(1));
        // Subscriptions from before Phase 17 get their channelId filled in.
        allow update: if isMyAccount(uid) && onlyChanges(['channelId']) &&
          request.resource.data.channelId == channelId;
        // (A counter that is already 0 - e.g. a subscription made before
        // channels existed - stays at 0.)
        allow delete: if isMyAccount(uid) &&
          (!exists(channelDoc(channelId)) || subscribersChangeBy(-1) ||
            (get(channelDoc(channelId)).data.subscriberCount <= 0 &&
              subscribersChangeBy(0)));
      }

      // ---- Notifications (in-app) ----
      // notifications/{id}: type ('upload' / 'comment' / 'reply'), fromUid,
      // fromName, fromAvatarUrl, fromAvatarColor (optional), videoId,
      // videoTitle, thumbnailUrl, isShort, commentId, replyId, text, read,
      // createdAt.
      // There is no server, so the SENDER's app writes into my folder. It
      // may only do that for something it really did, to the right person:
      // - upload:  its own video, and I am subscribed to its channel;
      // - comment: its own comment on MY video;
      // - reply:   its own reply to MY comment.
      // The id says what it is about (u_/c_/r_ + id), so nothing can be
      // sent twice (a second create of the same id is refused).
      match /notifications/{notificationId} {
        function isNotification(d) {
          return d.keys().hasOnly(['type', 'fromUid', 'fromName',
              'fromAvatarUrl', 'fromAvatarColor', 'videoId', 'videoTitle',
              'thumbnailUrl', 'isShort', 'commentId', 'replyId', 'text',
              'read', 'createdAt']) &&
            d.keys().hasAll(['type', 'fromUid', 'fromName', 'fromAvatarUrl',
              'videoId', 'videoTitle', 'thumbnailUrl', 'isShort', 'commentId',
              'replyId', 'text', 'read', 'createdAt']) &&
            d.fromUid == request.auth.uid &&
            d.fromName == get(userDoc(request.auth.uid)).data.displayName &&
            (d.fromAvatarUrl == '' || isCloudinaryUrl(d.fromAvatarUrl)) &&
            (!('fromAvatarColor' in d) || isColor(d.fromAvatarColor)) &&
            d.videoId is string && d.commentId is string &&
            d.replyId is string &&
            // (Security review: the sender can't make up what I see.)
            d.videoTitle == get(videoDoc(d.videoId)).data.title &&
            (d.thumbnailUrl == '' || isCloudinaryUrl(d.thumbnailUrl)) &&
            d.isShort is bool &&
            isText(d.text, 0, 200) &&
            d.read == false &&
            d.createdAt == request.time;
        }

        allow read, delete: if isMe(uid);
        // I mark it read / unread.
        allow update: if isMe(uid) && onlyChanges(['read']) &&
          request.resource.data.read is bool;

        allow create: if hasAccount() && uid != request.auth.uid &&
          isNotification(request.resource.data) &&
          (
            // A new upload by the sender, to its subscriber (me).
            (request.resource.data.type == 'upload' &&
              notificationId == 'u_' + request.resource.data.videoId &&
              request.resource.data.commentId == '' &&
              request.resource.data.replyId == '' &&
              get(videoDoc(request.resource.data.videoId)).data.uploaderUid ==
                request.auth.uid &&
              get(videoDoc(request.resource.data.videoId)).data.visibility ==
                'public' &&
              exists(/databases/$(database)/documents/users/$(uid)/subscribed/$('user-' + request.auth.uid))) ||
            // The sender's comment on my video.
            (request.resource.data.type == 'comment' &&
              notificationId == 'c_' + request.resource.data.commentId &&
              request.resource.data.replyId == '' &&
              get(videoDoc(request.resource.data.videoId)).data.uploaderUid == uid &&
              get(commentDoc(request.resource.data.videoId,
                request.resource.data.commentId)).data.uid == request.auth.uid) ||
            // The sender's reply to my comment.
            (request.resource.data.type == 'reply' &&
              notificationId == 'r_' + request.resource.data.replyId &&
              get(commentDoc(request.resource.data.videoId,
                request.resource.data.commentId)).data.uid == uid &&
              get(replyDoc(request.resource.data.videoId,
                request.resource.data.commentId,
                request.resource.data.replyId)).data.uid == request.auth.uid)
          );
      }

      // ---- Comment likes ----
      // commentLikes/{videoId}_{id}: videoId, commentId, likedAt, and for
      // a reply also parentId (the comment it belongs to; commentId is
      // then the reply's id). The liked comment's / reply's counter must
      // go +1 (like) / -1 (unlike) in the same batch.
      match /commentLikes/{likeId} {
        function commentLikesChangeBy(videoId, commentId, change) {
          return getAfter(commentDoc(videoId, commentId)).data.likes ==
            get(commentDoc(videoId, commentId)).data.likes + change;
        }
        function replyLikesChangeBy(videoId, commentId, replyId, change) {
          return getAfter(replyDoc(videoId, commentId, replyId)).data.likes ==
            get(replyDoc(videoId, commentId, replyId)).data.likes + change;
        }
        // The liked comment or reply ([like] = the like record).
        function likedChangeBy(like, change) {
          return (!('parentId' in like) &&
              commentLikesChangeBy(like.videoId, like.commentId, change)) ||
            ('parentId' in like &&
              replyLikesChangeBy(like.videoId, like.parentId, like.commentId, change));
        }
        function likedIsGone(like) {
          return (!('parentId' in like) &&
              !exists(commentDoc(like.videoId, like.commentId))) ||
            ('parentId' in like &&
              !exists(replyDoc(like.videoId, like.parentId, like.commentId)));
        }

        allow read: if isMe(uid);
        allow create: if isMyAccount(uid) &&
          request.resource.data.keys().hasOnly(
            ['videoId', 'commentId', 'parentId', 'likedAt']) &&
          request.resource.data.videoId is string &&
          request.resource.data.commentId is string &&
          (!('parentId' in request.resource.data) ||
            request.resource.data.parentId is string) &&
          likeId == request.resource.data.videoId + '_' + request.resource.data.commentId &&
          request.resource.data.likedAt == request.time &&
          likedChangeBy(request.resource.data, 1);
        allow delete: if isMyAccount(uid) &&
          (likedIsGone(resource.data) || likedChangeBy(resource.data, -1));
      }
    }

    // ================= Channels =================
    // channels/{channelId}: name, handle, description, bannerUrl,
    // avatarUrl, avatarColor, subscriberCount, ownerUid, createdAt.
    // - 6 sample channels (owner 'seed'), written on first launch;
    // - one per account: 'user-{uid}', same name / handle / color as the
    //   profile in users/{uid}.
    match /channels/{channelId} {
      function isAbout(value) {
        return isText(value, 0, 1000);
      }
      function isBanner(value) {
        return value == '' || isCloudinaryUrl(value);
      }
      function channelKeys() {
        return ['name', 'handle', 'description', 'bannerUrl', 'avatarUrl',
          'avatarColor', 'subscriberCount', 'ownerUid', 'createdAt',
          'keywords'];
      }
      // My profile, as it will be after this request.
      function myProfileAfter() {
        return getAfter(userDoc(request.auth.uid)).data;
      }

      allow read: if signedIn();

      allow create: if
        // A sample channel (by a guest or account, on first launch).
        (signedIn() &&
          channelId in ['blender-foundation', 'ev-weekly', 'gearhead-garage',
            'trail-and-tarmac', 'night-out-live', 'quick-clips'] &&
          request.resource.data.keys().hasOnly(channelKeys()) &&
          request.resource.data.ownerUid == 'seed' &&
          isText(request.resource.data.name, 1, 50) &&
          isHandle(request.resource.data.handle) &&
          isBanner(request.resource.data.bannerUrl) &&
          request.resource.data.subscriberCount is int) ||
        // My own channel: starts at 0 subscribers, copies my profile.
        (hasAccount() && channelId == 'user-' + request.auth.uid &&
          request.resource.data.keys().hasOnly(channelKeys()) &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.name == myProfileAfter().displayName &&
          request.resource.data.handle == myProfileAfter().handle &&
          request.resource.data.avatarColor == myProfileAfter().avatarColor &&
          isHandle(request.resource.data.handle) &&
          handleIsMineAfter(request.resource.data.handle) &&
          isAbout(request.resource.data.description) &&
          isBanner(request.resource.data.bannerUrl) &&
          (request.resource.data.avatarUrl == '' ||
            isCloudinaryUrl(request.resource.data.avatarUrl)) &&
          request.resource.data.subscriberCount == 0 &&
          request.resource.data.createdAt == request.time);

      allow update: if
        // "Edit channel" by its owner (never the subscriber count).
        (isMyAccount(resource.data.ownerUid) &&
          onlyChanges(['name', 'handle', 'description', 'bannerUrl',
            'avatarColor', 'keywords']) &&
          (!changes('keywords') || isKeywords(request.resource.data.keywords)) &&
          request.resource.data.name == myProfileAfter().displayName &&
          request.resource.data.handle == myProfileAfter().handle &&
          request.resource.data.avatarColor == myProfileAfter().avatarColor &&
          (!changes('handle') || handleIsMineAfter(request.resource.data.handle)) &&
          isAbout(request.resource.data.description) &&
          isBanner(request.resource.data.bannerUrl)) ||
        // Someone else (un)subscribes: +1 / -1, together with their own
        // users/{uid}/subscribed record.
        (hasAccount() && resource.data.ownerUid != request.auth.uid &&
          onlyChanges(['subscriberCount']) &&
          ((request.resource.data.subscriberCount ==
                resource.data.subscriberCount + 1 &&
              !exists(mySubscriptionDoc(channelId)) &&
              existsAfter(mySubscriptionDoc(channelId))) ||
            (request.resource.data.subscriberCount ==
                resource.data.subscriberCount - 1 &&
              exists(mySubscriptionDoc(channelId)) &&
              !existsAfter(mySubscriptionDoc(channelId))))) ||
        isKeywordsFillIn();

      allow delete: if false;
    }

    // ================= Handles =================
    // handles/{@handle}: uid. Reserves an @handle for one account, so two
    // channels can't have the same one. I can only reserve the handle my
    // profile uses after this request, and only release my own.
    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if hasAccount() && isHandle(handle) &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid == request.auth.uid &&
        getAfter(userDoc(request.auth.uid)).data.handle == handle;
      allow delete: if hasAccount() && resource.data.uid == request.auth.uid;
    }

    // ================= Playlists =================
    // playlists/{playlistId}: ownerUid, channelId ('user-{uid}'), title,
    // visibility ('public' / 'private'), videoIds (in order, up to 200),
    // createdAt, updatedAt.
    // Public playlists show on the owner's channel; private ones only to
    // the owner. (Liked videos and Watch later are not stored here.)
    match /playlists/{playlistId} {
      function isPlaylist(d) {
        return isText(d.title, 1, 150) &&
          d.visibility in ['public', 'private'] &&
          d.videoIds is list && d.videoIds.size() <= 200 &&
          d.updatedAt == request.time;
      }

      allow read: if signedIn() &&
        (resource.data.visibility == 'public' ||
          resource.data.ownerUid == request.auth.uid);

      allow create: if hasAccount() &&
        request.resource.data.keys().hasOnly(['ownerUid', 'channelId', 'title',
          'visibility', 'videoIds', 'createdAt', 'updatedAt']) &&
        request.resource.data.keys().hasAll(['ownerUid', 'channelId', 'title',
          'visibility', 'videoIds', 'createdAt', 'updatedAt']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.channelId == 'user-' + request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        isPlaylist(request.resource.data);

      // The owner renames it, changes Public / Private, adds, removes or
      // reorders videos (never the owner or the channel).
      allow update: if isMyAccount(resource.data.ownerUid) &&
        onlyChanges(['title', 'visibility', 'videoIds', 'updatedAt']) &&
        isPlaylist(request.resource.data);

      allow delete: if isMyAccount(resource.data.ownerUid);
    }

    // ================= Reports =================
    // reports/{videoId}_{uid}: reporterUid, videoId, reason, details,
    // createdAt. An account can report a video ONCE (the id is fixed, and
    // a second create of the same id is refused). Reports are read in the
    // Firebase console; in the app you can only see whether YOU reported
    // a video (the id ends with your uid, so this works even before the
    // report exists).
    match /reports/{reportId} {
      allow read: if hasAccount() && reportId.matches('.+_' + request.auth.uid);
      allow create: if hasAccount() &&
        request.resource.data.keys().hasOnly(['reporterUid', 'videoId',
          'reason', 'details', 'createdAt']) &&
        request.resource.data.keys().hasAll(['reporterUid', 'videoId',
          'reason', 'details', 'createdAt']) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.videoId is string &&
        reportId == request.resource.data.videoId + '_' + request.auth.uid &&
        exists(videoDoc(request.resource.data.videoId)) &&
        request.resource.data.reason in ['sexual', 'violent', 'hateful',
          'harassment', 'harmful', 'misinformation', 'spam', 'rights',
          'other'] &&
        isText(request.resource.data.details, 0, 500) &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ================= Videos =================
    // videos/{videoId}: title, description, videoUrl, thumbnailUrl,
    // durationSeconds, channelId, channelName, channelAvatarUrl,
    // subscriberCount, views, likes, category, isShort, uploaderUid,
    // createdAt, visibility, commentCount (+ sampleKey on the 13 seed
    // videos; lastCommentId / lastReplyId / pinnedCommentId later).
    match /videos/{videoId} {

      function isCategory(value) {
        return value in ['Animation', 'Cars', 'Entertainment', 'Sci-Fi', 'Other'];
      }
      function isVisibility(value) {
        return value in ['public', 'unlisted'];
      }
      // Up to 4 hours.
      function isLength(value) {
        return value is int && value >= 0 && value <= 14400;
      }

      // The 13 sample videos. The app writes them on its very first launch
      // (which may be by a guest), with these exact ids.
      // (Security review: only the known fields, links to OUR Cloudinary
      // account and whole numbers - nobody can plant a link to another
      // site in a sample video.)
      function isSeedCreate() {
        let d = request.resource.data;
        return signedIn() &&
          videoId in ['big_buck_bunny', 'elephants_dream', 'sintel',
            'tears_of_steel', 'zeekr_x_review', 'rally_drone_chase',
            'snow_forest_drive', 'sherp_icebergs', 'bund_fireworks',
            'fire_juggling', 'vettisfossen_waterfall', 'tgv_passing',
            'magpies_calling'] &&
          d.keys().hasOnly(['sampleKey', 'title', 'description', 'videoUrl',
            'thumbnailUrl', 'durationSeconds', 'channelId', 'channelName',
            'channelAvatarUrl', 'subscriberCount', 'views', 'likes',
            'commentCount', 'keywords', 'category', 'isShort', 'uploaderUid',
            'visibility', 'createdAt']) &&
          d.uploaderUid == 'seed' &&
          d.sampleKey == videoId &&
          isText(d.title, 1, 100) &&
          isText(d.description, 0, 5000) &&
          isCloudinaryUrl(d.videoUrl) &&
          isCloudinaryUrl(d.thumbnailUrl) &&
          d.channelAvatarUrl == '' &&
          isLength(d.durationSeconds) &&
          d.subscriberCount is int && d.views is int && d.likes is int &&
          (!('commentCount' in d) || d.commentCount == 0) &&
          (!('keywords' in d) || isKeywords(d.keywords)) &&
          isCategory(d.category) &&
          d.isShort is bool &&
          d.visibility == 'public';
      }

      // A new upload by me: starts at 0 views / 0 likes, uses my own
      // channel and profile name, and points to our Cloudinary account.
      function isUploadCreate() {
        let d = request.resource.data;
        return hasAccount() &&
          d.keys().hasOnly(['title', 'description', 'videoUrl', 'thumbnailUrl',
            'durationSeconds', 'channelId', 'channelName', 'channelAvatarUrl',
            'subscriberCount', 'views', 'likes', 'category', 'isShort',
            'uploaderUid', 'createdAt', 'visibility', 'channelAvatarColor',
            'commentCount', 'keywords']) &&
          (!('keywords' in d) || isKeywords(d.keywords)) &&
          d.uploaderUid == request.auth.uid &&
          d.channelId == 'user-' + request.auth.uid &&
          d.channelName == get(userDoc(request.auth.uid)).data.displayName &&
          isText(d.title, 1, 100) &&
          isText(d.description, 0, 5000) &&
          isCloudinaryUrl(d.videoUrl) &&
          isCloudinaryUrl(d.thumbnailUrl) &&
          (d.channelAvatarUrl == '' || isCloudinaryUrl(d.channelAvatarUrl)) &&
          (!('channelAvatarColor' in d) || isColor(d.channelAvatarColor)) &&
          isLength(d.durationSeconds) &&
          d.subscriberCount == 0 &&
          d.views == 0 &&
          d.likes == 0 &&
          (!('commentCount' in d) || d.commentCount == 0) &&
          isCategory(d.category) &&
          d.isShort is bool &&
          isVisibility(d.visibility) &&
          d.createdAt is timestamp &&
          d.createdAt <= request.time + duration.value(5, 'm');
      }

      // The uploader edits their video's details (not its counters).
      // Channel name / color follow the profile (also when both change in
      // the same "Edit channel" batch, hence getAfter).
      function isOwnerEdit() {
        let d = request.resource.data;
        return isMyAccount(resource.data.uploaderUid) &&
          onlyChanges(['title', 'description', 'thumbnailUrl', 'category',
            'visibility', 'channelName', 'channelAvatarUrl',
            'channelAvatarColor', 'keywords']) &&
          (!changes('keywords') || isKeywords(d.keywords)) &&
          isText(d.title, 1, 100) &&
          isText(d.description, 0, 5000) &&
          (!changes('thumbnailUrl') || isCloudinaryUrl(d.thumbnailUrl)) &&
          (!changes('channelAvatarUrl') || d.channelAvatarUrl == '' ||
            isCloudinaryUrl(d.channelAvatarUrl)) &&
          (!changes('channelName') ||
            d.channelName == getAfter(userDoc(request.auth.uid)).data.displayName) &&
          (!changes('channelAvatarColor') ||
            d.channelAvatarColor == getAfter(userDoc(request.auth.uid)).data.avatarColor) &&
          isCategory(d.category) &&
          isVisibility(d.visibility);
      }

      // The comment counter moves together with the comment or reply that
      // was added or deleted (named in lastCommentId / lastReplyId):
      // +1 for a new one, -1 for a deleted reply, and -1 minus its replies
      // for a deleted comment (its replies go in the same batch).
      function isCommentCountChange() {
        let d = request.resource.data;
        let before = resource.data.get('commentCount', 0);
        return hasAccount() &&
          onlyChanges(['commentCount', 'lastCommentId', 'lastReplyId']) &&
          d.commentCount is int &&
          d.lastCommentId is string && d.lastReplyId is string &&
          (
            // A new comment.
            (d.lastReplyId == '' && d.commentCount == before + 1 &&
              !exists(commentDoc(videoId, d.lastCommentId)) &&
              existsAfter(commentDoc(videoId, d.lastCommentId))) ||
            // A new reply.
            (d.lastReplyId != '' && d.commentCount == before + 1 &&
              !exists(replyDoc(videoId, d.lastCommentId, d.lastReplyId)) &&
              existsAfter(replyDoc(videoId, d.lastCommentId, d.lastReplyId))) ||
            // A deleted comment (with its replies).
            (d.lastReplyId == '' &&
              exists(commentDoc(videoId, d.lastCommentId)) &&
              !existsAfter(commentDoc(videoId, d.lastCommentId)) &&
              countIs(before - 1 -
                get(commentDoc(videoId, d.lastCommentId)).data.get('replyCount', 0),
                d.commentCount)) ||
            // A deleted reply.
            (d.lastReplyId != '' &&
              exists(replyDoc(videoId, d.lastCommentId, d.lastReplyId)) &&
              !existsAfter(replyDoc(videoId, d.lastCommentId, d.lastReplyId)) &&
              countIs(before - 1, d.commentCount))
          );
      }

      allow read: if signedIn();

      allow create: if isSeedCreate() || isUploadCreate();

      allow update: if isOwnerEdit() ||
        // Anyone watching (guests too): exactly +1 view.
        (signedIn() && onlyChanges(['views']) &&
          request.resource.data.views == resource.data.views + 1) ||
        // Anyone watching: the player saves a LONGER length than the one
        // saved (a wrong length is always too short), up to 4 hours.
        (signedIn() && onlyChanges(['durationSeconds']) &&
          isLength(request.resource.data.durationSeconds) &&
          request.resource.data.durationSeconds > resource.data.durationSeconds) ||
        // Liking / un-liking (accounts only): +1 or -1, and only together
        // with my own reaction record (see users/{uid}/reactions).
        (hasAccount() && onlyChanges(['likes']) &&
          ((request.resource.data.likes == resource.data.likes + 1 &&
              !likedBefore(videoId) && likedAfter(videoId)) ||
            (request.resource.data.likes == resource.data.likes - 1 &&
              likedBefore(videoId) && !likedAfter(videoId)))) ||
        // Comments / replies added or deleted (accounts only).
        isCommentCountChange() ||
        // Search keywords for a video from before Phase 18.
        isKeywordsFillIn() ||
        // Videos from before Phase 14 have no comment counter: the first
        // person to open one counts the comments and fills it in, once.
        (signedIn() && onlyChanges(['commentCount']) &&
          !('commentCount' in resource.data) &&
          request.resource.data.commentCount is int &&
          request.resource.data.commentCount >= 0 &&
          request.resource.data.commentCount <= 100000) ||
        // The uploader pins one comment to the top ('' = none).
        (isMyAccount(resource.data.uploaderUid) &&
          onlyChanges(['pinnedCommentId']) &&
          request.resource.data.pinnedCommentId is string &&
          (request.resource.data.pinnedCommentId == '' ||
            exists(commentDoc(videoId, request.resource.data.pinnedCommentId))));

      allow delete: if isMyAccount(resource.data.uploaderUid);

      // ================= Comments =================
      // comments/{commentId}: uid, displayName, handle, avatarUrl, text,
      // likes, replyCount, createdAt (+ edited, editedAt, hearted,
      // lastReplyId later).
      match /comments/{commentId} {
        allow read: if signedIn();

        // A new comment: the video's counter goes +1 in the same batch.
        allow create: if isNewCommentByMe(
            ['uid', 'displayName', 'handle', 'avatarUrl', 'text', 'likes',
              'replyCount', 'createdAt']) &&
          (!('replyCount' in request.resource.data) ||
            request.resource.data.replyCount == 0) &&
          commentCountMovedBy(videoId, 1);

        allow update: if isAuthorEdit() ||
          isCommentLikeChange(videoId, commentId) ||
          isCreatorHeart(videoId) ||
          // A reply was added / deleted: replyCount +1 / -1 together with it.
          (hasAccount() && onlyChanges(['replyCount', 'lastReplyId']) &&
            request.resource.data.lastReplyId is string &&
            ((request.resource.data.replyCount ==
                  resource.data.get('replyCount', 0) + 1 &&
                !exists(replyDoc(videoId, commentId, request.resource.data.lastReplyId)) &&
                existsAfter(replyDoc(videoId, commentId, request.resource.data.lastReplyId))) ||
              (countIs(resource.data.get('replyCount', 0) - 1,
                  request.resource.data.replyCount) &&
                exists(replyDoc(videoId, commentId, request.resource.data.lastReplyId)) &&
                !existsAfter(replyDoc(videoId, commentId, request.resource.data.lastReplyId)))));

        // The author deletes it (its replies go in the same batch); the
        // video's counter goes down by 1 + its replies.
        allow delete: if isMyAccount(resource.data.uid) &&
          commentCountMovedBy(videoId, -1 - resource.data.get('replyCount', 0));

        // ================= Replies =================
        // replies/{replyId}: uid, displayName, handle, avatarUrl, text,
        // likes, createdAt (+ edited, editedAt, hearted later).
        // One level deep: replies have no replies of their own.
        match /replies/{replyId} {
          allow read: if signedIn();

          // A new reply to an existing comment: the comment's replyCount
          // and the video's commentCount go +1 in the same batch.
          allow create: if isNewCommentByMe(
              ['uid', 'displayName', 'handle', 'avatarUrl', 'text', 'likes',
                'createdAt']) &&
            exists(commentDoc(videoId, commentId)) &&
            replyCountMovedBy(videoId, commentId, 1) &&
            commentCountMovedBy(videoId, 1);

          allow update: if isAuthorEdit() ||
            isCommentLikeChange(videoId, replyId) ||
            isCreatorHeart(videoId);

          allow delete: if
            // The author deletes their reply: both counters go -1.
            (isMyAccount(resource.data.uid) &&
              replyCountMovedBy(videoId, commentId, -1) &&
              commentCountMovedBy(videoId, -1)) ||
            // The comment's author deletes the comment, and its replies
            // with it (in the same batch).
            (hasAccount() &&
              !existsAfter(commentDoc(videoId, commentId)) &&
              get(commentDoc(videoId, commentId)).data.uid == request.auth.uid);
        }
      }
    }

    // ================= Subscribers of a channel =================
    // A channel's owner finds who subscribed to it (to send upload
    // notifications): a collection-group query over every user's
    // subscribed/ folder, limited to their own channel.
    match /{path=**}/subscribed/{channelId} {
      allow read: if hasAccount() &&
        resource.data.channelId == 'user-' + request.auth.uid;
    }
  }
}
