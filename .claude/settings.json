      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(flutter build web *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(flutter pub get *)",
